# Supabase Dashboard -> Project Settings -> API Keys

# Project URL (contoh: https://abcdefgh.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Publishable key (sb_publishable_...) — pengganti "anon". Dipakai utk endpoint Auth.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) — RAHASIA, server-only, bypass RLS. Pengganti "service_role".
SUPABASE_SECRET_KEY=sb_secret_xxx

# Legacy fallback (opsional — code otomatis pakai ini kalau yang di atas kosong):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Origin frontend (Cloudflare). Untuk CORS + redirect Google OAuth.
# Dev lokal otomatis diizinkan: http://localhost:5173
FRONTEND_URL=https://docgen.karuhundeveloper.com
